+// LOCAL (no-DNS build): every server host name is replaced by this IP literal,
+// in the stage0 Gecko code, in stage1 and in the payload's resolver hooks, so the
+// game never issues a DNS query for the private server.
+#ifndef WWFC_LOCAL_IP
+#  define WWFC_LOCAL_IP "127.0.0.1"
+#endif
+
 #endif // WWFC_CONSTANTS

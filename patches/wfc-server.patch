@@ -0,0 +1,44 @@
+package filter
+
+import "testing"
+
+func evalFilter(t *testing.T, expr string, server map[string]string, game string) int64 {
+	t.Helper()
+	tree, err := Parse(expr)
+	if err != nil {
+		t.Fatalf("parse %q: %v", expr, err)
+	}
+	ret, err := Eval(tree, server, game)
+	if err != nil {
+		t.Fatalf("eval %q: %v", expr, err)
+	}
+	return ret
+}
+
+func TestMarioKartWiiIgnoresPFlag(t *testing.T) {
+	server := map[string]string{
+		"dwc_mver": "90", "dwc_pid": "1000000000", "maxplayers": "11", "numplayers": "1",
+		"dwc_mtype": "0", "dwc_hoststate": "2", "dwc_suspend": "0",
+		"rk": "vs", "ev": "4601", "p": "1",
+	}
+	for _, p := range []string{"0", "1"} {
+		expr := "dwc_mver = 90 and dwc_pid != 1000000001 and maxplayers = 11 and numplayers < 11 and dwc_mtype = 0 and dwc_hoststate = 2 and dwc_suspend = 0 and (rk = 'vs' and ev >= 4220 and ev <= 5720 and p = " + p + ")"
+		if got := evalFilter(t, expr, server, "mariokartwii"); got != 1 {
+			t.Errorf("mariokartwii with p = %s against host p = 1: got %d, want 1", p, got)
+		}
+	}
+
+	// Other terms still apply: a battle search must not match a VS host.
+	expr := "dwc_mver = 90 and (rk = 'bt' and eb >= 1 and eb <= 9999 and p = 0)"
+	if got := evalFilter(t, expr, server, "mariokartwii"); got != 0 {
+		t.Errorf("rk mismatch: got %d, want 0", got)
+	}
+
+	// Other games keep the plain comparison.
+	if got := evalFilter(t, "p = 0", server, "othergame"); got != 0 {
+		t.Errorf("othergame p = 0 against p = 1: got %d, want 0", got)
+	}
+	if got := evalFilter(t, "p = 1", server, "othergame"); got != 1 {
+		t.Errorf("othergame p = 1 against p = 1: got %d, want 1", got)
+	}
+}

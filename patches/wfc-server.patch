+// debugMatch (env WWFC_DEBUG_MATCH=1, local patch) logs every candidate room of a
+// matchmaking search and whether it matched, to see why consoles do not find a room.
+var debugMatch = os.Getenv("WWFC_DEBUG_MATCH") == "1"
